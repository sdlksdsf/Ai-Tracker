# =============================================================================
# PlateMatch — environment template
# =============================================================================
# Copy to .env and fill in what you need:
#
#   cp .env.example .env
#
# EVERYTHING BELOW IS OPTIONAL. With no keys at all, PlateMatch runs end to end
# using its built-in deterministic engine:
#
#   • fridge scans      → return an honest "nothing detected" plus guidance,
#                         never invented ingredients
#   • recipe generation → draws from a bundled 32-recipe corpus and re-checks it
#                         against your allergies
#   • meal plans        → assembled from the same corpus, nutrition verified
#   • nutrition         → ~110-entry USDA composition table
#   • grocery prices    → offline price index
#   • payments          → checkout is simulated and grants the tier locally
#
# Add a key for any one capability and only that capability goes live. See
# `AI_MODE` below for the exact rules.
#
# Nothing in this file is a secret. `.env` is gitignored.


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Bind 0.0.0.0 inside containers; 127.0.0.1 is safer on a workstation.
HOST=0.0.0.0
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8081
APP_VERSION=1.0.0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Pretty-printed logs for local development. Never enable in production.
LOG_PRETTY=true

# Set when the API sits behind a load balancer, so X-Forwarded-For is trusted
# and rate limiting keys on the real client IP rather than the proxy.
TRUST_PROXY=false

# Comma-separated allow-list, or * for any origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# API version prefix. Changing this breaks every existing client.
API_PREFIX=/api/v1


# -----------------------------------------------------------------------------
# Database — PostgreSQL 16
# -----------------------------------------------------------------------------
# Matches docker-compose.yml, so `npm run db:up` needs no edits.
DATABASE_URL=postgresql://platematch:platematch@localhost:5432/platematch
DATABASE_POOL_MAX=10

# Run pending migrations at boot. Convenient locally; in production prefer an
# explicit `npm run db:migrate` step in your deploy so a bad migration cannot
# take down every replica at once.
DATABASE_MIGRATE_ON_BOOT=true

# Create the demo account (see SEED_DEMO_* below) on boot.
SEED_DEMO_USER=true


# -----------------------------------------------------------------------------
# Cache & queue — Redis 7
# -----------------------------------------------------------------------------
# Also matches docker-compose.yml.
REDIS_URL=redis://localhost:6379

# false → an in-memory cache and an in-process job queue. Perfect for a single
# local process; REQUIRED to be true for more than one replica, otherwise rate
# limits, quotas and notification de-duplication are per-instance.
ENABLE_REDIS=true

# Run the BullMQ job processors inside the API process. Set false when you run
# `npm run worker` (or deploy/Dockerfile.worker) as a separate service.
ENABLE_WORKER=true

# Run the scheduled notification sweeps. Disable on every replica but one, or
# each of them will try to send the same alert.
ENABLE_CRONS=true

# Prefix for queue names, so two environments can share one Redis.
QUEUE_PREFIX=platematch


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — the server refuses to start with a dev default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_ISSUER=platematch
JWT_AUDIENCE=platematch-app

# 15 minutes / 7 days. Refresh tokens rotate on every use and reuse of a rotated
# token revokes the whole family.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Google Sign-In (optional) -----------------------------------------------
# iOS/Android clients send an ID token; the server verifies it against Google's
# JWKS. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
# Only needed for the web authorization-code flow; the mobile apps send an ID
# token directly, which is verified against Google's JWKS with no secret.
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple (optional) -------------------------------------------
# Requires a .p8 key from the Apple Developer portal.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Single-line PKCS#8 key: replace newlines with \n
APPLE_PRIVATE_KEY=

# Skip JWKS signature verification. FOR LOCAL DEVELOPMENT ONLY — the server logs
# a warning on every start while this is true, and it must never reach production.
INSECURE_SKIP_OAUTH_VERIFY=false


# -----------------------------------------------------------------------------
# AI — model selection
# -----------------------------------------------------------------------------
# auto  → use live providers when the relevant keys exist, otherwise the
#         built-in deterministic engine (the default; a fresh clone just works)
# live  → always call providers; fail loudly if a key is missing
# mock  → always use the built-in engine (tests, CI, demos, offline work)
AI_MODE=auto

# --- Vision: fridge scanning -------------------------------------------------
# Checked in order; the first one with a working key is used, and a failure falls
# through to the next.
AI_VISION_PRIMARY_MODEL=gemini-3-pro
AI_VISION_FALLBACK_MODEL=gpt-5.6-terra
# Cheaper model for batch/fast paths.
AI_VISION_FAST_MODEL=gemini-3-flash
AI_VISION_BASE_URL=
AI_VISION_OPENAI_BASE_URL=
AI_VISION_TIMEOUT_MS=45000
AI_VISION_MAX_RETRIES=2
# Detections below this confidence are dropped entirely.
AI_VISION_CONFIDENCE_FALLBACK=0.75

# --- Reasoning: recipes and meal plans ---------------------------------------
AI_REASONING_PRIMARY_MODEL=claude-sonnet-5
AI_REASONING_FALLBACK_MODEL=gpt-5.6-sol
# Cost-effective model for batch work and swaps.
AI_REASONING_BATCH_MODEL=gemini-3-flash
AI_RECIPE_TEMPERATURE=0.7
AI_RECIPE_MAX_TOKENS=4096
AI_MEALPLAN_TEMPERATURE=0.6
AI_MEALPLAN_MAX_TOKENS=8192

# Shared request budget.
AI_TIMEOUT_MS=60000

# --- Provider keys -----------------------------------------------------------
# Any one of these enables live vision; any one enables live reasoning.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_ANTHROPIC_VERSION=2023-06-01

# Optional: Google Cloud Vision for object bounding boxes on fridge photos.
# Purely additive — the app works without it.
GOOGLE_CLOUD_VISION_KEY=


# -----------------------------------------------------------------------------
# AI — nutrition & grocery prices
# -----------------------------------------------------------------------------
# Edamam Nutrition Analysis, then Spoonacular, then the bundled USDA table.
EDAMAM_BASE_URL=https://api.edamam.com
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

SPOONACULAR_BASE_URL=https://api.spoonacular.com
SPOONACULAR_API_KEY=

# Kroger Product Search for real shelf prices. Needs a location id.
KROGER_BASE_URL=https://api.kroger.com/v1
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_DEFAULT_LOCATION_ID=


# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# local | cloudinary | s3
# `local` writes to LOCAL_UPLOAD_DIR and serves from /uploads/*. It is rejected
# in production (the server refuses to start) because it does not survive a
# redeploy.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# The upload cap is NOT configurable here on purpose: it lives in
# UPLOAD_LIMITS.maxBytes (packages/shared/src/constants) so the mobile client and
# the API enforce the same 10 MB limit from one definition.

# --- Cloudinary (recommended for production) ---------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=platematch

# --- S3-compatible (AWS S3, Cloudflare R2, Supabase Storage, MinIO) ----------
# docker-compose ships MinIO on port 9000 for local development.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Per user per minute (per IP for the auth routes).
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_SCAN_MAX=5
RATE_LIMIT_AUTH_MAX=10

# Tests only. Never set this in production.
RATE_LIMIT_DISABLED=false


# -----------------------------------------------------------------------------
# Payments — Stripe
# -----------------------------------------------------------------------------
# Blank → checkout runs in SIMULATED mode: the tier is granted locally and the
# response carries `simulated: true`, which the app surfaces honestly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ids from the Stripe dashboard.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=

# Forwards `stripe listen --forward-to localhost:4000/api/v1/subscription/webhook`
# locally to populate STRIPE_WEBHOOK_SECRET.


# -----------------------------------------------------------------------------
# Push notifications
# -----------------------------------------------------------------------------
ENABLE_PUSH=true

# Expo Push Service — the default path, works for both iOS and Android.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Direct FCM, used instead of Expo when configured.
FCM_SERVER_KEY=


# -----------------------------------------------------------------------------
# Observability (both optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

ENABLE_ANALYTICS=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com


# -----------------------------------------------------------------------------
# API documentation
# -----------------------------------------------------------------------------
# Serves OpenAPI 3.1 at /docs and /api/v1/openapi.json.
# Disabled by default in production; enable temporarily to debug a deployment.
ENABLE_SWAGGER=true


# -----------------------------------------------------------------------------
# Demo seed account
# -----------------------------------------------------------------------------
# Created when SEED_DEMO_USER=true: the demo user, a 24-item pantry with a few
# things about to expire, and the full 32-recipe corpus published as public
# recipes. Idempotent — running it twice changes nothing.
SEED_DEMO_EMAIL=demo@platematch.app
SEED_DEMO_PASSWORD=PlateMatch2025
# Seed on a paid tier so Premium features (price comparison, voice cooking) are
# explorable without a Stripe account.
SEED_DEMO_PREMIUM=false
